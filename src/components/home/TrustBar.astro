---
import { SITE } from '../../data/site';

const items = [
  { value: String(SITE.foundingYear), label: 'Año de fundación' },
  { value: 'CAL', label: 'Abogado colegiado y habilitado' },
  { value: '4', label: 'Áreas de práctica' },
  { value: 'Lun – Dom', label: 'Atención con cita previa' },
];
---

<section class="trust" aria-label="Datos del estudio">
  <ul class="container trust__list">
    {
      items.map((item) => (
        <li class="trust__item">
          <span class="trust__value">{item.value}</span>
          <span class="trust__label">{item.label}</span>
        </li>
      ))
    }
  </ul>
</section>

<style>
  .trust { background: var(--ivory); border-bottom: 1px solid #e6dfd2; }

  .trust__list {
    list-style: none;
    margin: 0 auto;
    padding-block: 40px;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 24px;
  }

  .trust__item { display: flex; flex-direction: column; gap: 4px; text-align: center; }

  .trust__value {
    font-family: var(--font-serif);
    font-size: 44px;
    font-weight: 600;
    line-height: 1.1;
    color: var(--navy);
  }

  .trust__label { font-size: 14px; color: #5a5a5a; }
</style>