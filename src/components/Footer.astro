---
import { Image } from 'astro:assets';
import { siTiktok, siFacebook, siInstagram } from 'simple-icons';
import logo from '../assets/logo.png';
import { SITE, SPECIALTIES, LEGAL_LINKS, whatsappUrl } from '../data/site';

const year = new Date().getFullYear();

const social = [
  { label: 'TikTok', href: SITE.social.tiktok, icon: siTiktok },
  { label: 'Facebook', href: SITE.social.facebook, icon: siFacebook },
  { label: 'Instagram', href: SITE.social.instagram, icon: siInstagram },
];
---

<footer class="footer">
  <div class="container footer__top">
    <div class="footer__brand">
      <Image src={logo} alt={SITE.name} height={64} />
      <p>Asesoría y defensa legal en Lima desde {SITE.foundingYear}.</p>
      <ul class="footer__social" aria-label="Redes sociales">
        {
          social.map((s) => (
            <li>
              <a href={s.href} target="_blank" rel="noopener" aria-label={s.label} title={s.label}>
                <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true" focusable="false">
                  <path d={s.icon.path} />
                </svg>
              </a>
            </li>
          ))
        }
      </ul>
    </div>

    <nav class="footer__col" aria-label="Especialidades">
      <h2 class="footer__title">Especialidades</h2>
      <ul>
        {SPECIALTIES.map((s) => <li><a href={`/especialidades/${s.slug}`}>{s.title}</a></li>)}
      </ul>
    </nav>

    <div class="footer__col">
      <h2 class="footer__title">Contacto</h2>
      <ul>
        {SITE.whatsapp.map((w) => <li><a href={whatsappUrl(w.number)}>WhatsApp {w.label}</a></li>)}
        <li><a href={`mailto:${SITE.email}`}>{SITE.email}</a></li>
      </ul>
      <div class="footer__hours">
        {SITE.hours.map((h) => <p>{h.days}: {h.time}</p>)}
      </div>
    </div>
  </div>

  <div class="container footer__bottom">
    <div class="footer__meta">
      <p>© {year} {SITE.name}. Todos los derechos reservados.</p>
      <nav aria-label="Legal">
        <ul class="footer__legal">
          {LEGAL_LINKS.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
        </ul>
      </nav>
    </div>
    <p class="footer__disclaimer">
      La información de este sitio es referencial y no constituye asesoría legal. Cada caso requiere una evaluación
      particular. El uso de este sitio o el envío de una consulta no genera una relación abogado-cliente.
    </p>
  </div>
</footer>

<style>
  .footer {
    background: var(--navy-900);
    color: #a9b4b7;
    font-size: 14px;
  }

  .footer ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .footer a {
    color: #d5dcde;
    text-decoration: none;
    transition: color 0.2s;
  }

  .footer a:hover {
    color: var(--gold-light);
  }

  .footer__top {
    display: grid;
    grid-template-columns: 1.2fr 1fr 1fr;
    gap: 48px;
    padding-block: 72px 56px;
  }

  .footer__brand img {
    display: block;
    width: auto;
    margin-bottom: 20px;
  }

  .footer__brand p {
    max-width: 280px;
    line-height: 1.6;
  }

  .footer ul.footer__social {
    flex-direction: row;
    gap: 12px;
    margin-top: 24px;
  }

  .footer__social a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    border: 1px solid rgba(255, 255, 255, 0.16);
    border-radius: 50%;
    color: #d5dcde;
    transition: color 0.2s, border-color 0.2s;
  }

  .footer__social a:hover,
  .footer__social a:focus-visible {
    color: var(--gold-light);
    border-color: var(--gold);
  }

  .footer__title {
    font-family: var(--font-sans);
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--gold-light);
    margin-bottom: 20px;
  }

  .footer__hours {
    margin-top: 20px;
    color: #8a979a;
    line-height: 1.7;
  }

  .footer__hours p {
    margin: 0;
  }

  .footer__bottom {
    border-top: 1px solid rgba(255, 255, 255, 0.08);
    padding-block: 28px 36px;
    display: flex;
    flex-direction: column;
    gap: 18px;
    font-size: 13px;
  }

  .footer__meta {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 12px 32px;
  }

  .footer__meta p {
    color: #8a979a;
  }

  .footer ul.footer__legal {
    flex-direction: row;
    flex-wrap: wrap;
    gap: 8px 24px;
  }

  .footer__legal a {
    color: #a9b4b7;
  }

  .footer__disclaimer {
    max-width: 760px;
    font-size: 12px;
    line-height: 1.6;
    color: #8a979a;
  }

  @media (max-width: 860px) {
    .footer__top {
      grid-template-columns: 1fr 1fr;
    }

    .footer__brand {
      grid-column: 1 / -1;
    }
  }

  @media (max-width: 520px) {
    .footer__top {
      grid-template-columns: 1fr;
      gap: 40px;
      padding-block: 56px 40px;
    }
  }
</style>